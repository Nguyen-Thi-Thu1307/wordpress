    public function render_header() {
        $cart_count = (function_exists('WC') && WC()->cart) ? WC()->cart->get_cart_contents_count() : 0;
        $cart_url = function_exists('wc_get_cart_url') ? wc_get_cart_url() : home_url('/gio-hang/');
        $account_url = function_exists('wc_get_page_permalink') ? wc_get_page_permalink('myaccount') : home_url('/tai-khoan/');
        $order_url = home_url('/don-hang/');
        $news_url = home_url('/tin-tuc-su-kien/');
        $utilities_url = home_url('/tien-ich/');
        $contact_url = home_url('/lien-he/');
        $promo_url = home_url('/khuyen-mai/');
        $shop_url = home_url('/san-pham/');
        $is_logged = is_user_logged_in();
        $current_user = wp_get_current_user();
        ?>
        <!-- ================= BIBLIO BRAND HEADER ================= -->
        <header id="biblio-header" class="bb-header-wrap">
            
            <!-- TIER 1: TOPBAR -->
            <div class="bb-topbar">
                <div class="bb-container bb-topbar-inner">
                    <!-- Topbar Left -->
                    <div class="bb-topbar-left">
                        <a href="<?php echo esc_url($contact_url); ?>" class="bb-top-link">
                            <span class="bb-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                            </span>
                            <span>Trợ giúp</span>
                        </a>
                        <a href="<?php echo esc_url($news_url); ?>" class="bb-top-link">
