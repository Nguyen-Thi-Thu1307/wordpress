<?php
/**
 * Plugin Name: Biblio Theme Addons (Header & Footer UI)
 * Description: Tái hiện 100% giao diện Header và Footer theo chuẩn nhận diện thương hiệu Biblio (Bao gồm thanh Topbar, thanh tìm kiếm, nút Giỏ hàng WooCommerce, thanh danh mục ghim cố định & nút Sale Sốc Xả Kho, và Footer 4 cột có form bản tin mascot ong).
 * Version: 1.1.0
 * Author: Nhóm 3 TMĐT NEU - Biblio
 */

if (!defined('ABSPATH')) {
    exit;
}

class Biblio_Theme_UI {

    public function __construct() {
        // Enqueue Google Fonts
        add_action('wp_enqueue_scripts', [$this, 'enqueue_assets']);

        // Replace Astra Header & Footer
        add_action('wp', [$this, 'setup_header_footer_hooks']);

        // WooCommerce AJAX Cart Fragment update
        add_filter('woocommerce_add_to_cart_fragments', [$this, 'cart_fragment']);

        // ===== SINGLE PRODUCT PAGE CUSTOMIZATION =====
        // Add detailed info table before WC description tabs
        add_action('woocommerce_single_product_summary', [$this, 'product_meta_details'], 25);
        // Add trust badges after add-to-cart
        add_action('woocommerce_single_product_summary', [$this, 'product_trust_badges'], 35);
        // Related products section title
        add_filter('woocommerce_product_related_posts_heading', function() {
            return 'Sản Phẩm Cùng Loại';
        });
        // Change quantity of related products
        add_filter('woocommerce_output_related_products_args', function($args) {
            $args['posts_per_page'] = 5;
            $args['columns'] = 5;
            return $args;
        });
        // Single product styles
        add_action('wp_head', [$this, 'single_product_styles']);
        // Rename default WC tabs
        add_filter('woocommerce_product_tabs', [$this, 'rename_product_tabs'], 98);
    }

    public function enqueue_assets() {
        wp_enqueue_style(
            'biblio-fonts',
            'https://fonts.googleapis.com/css2?family=Margarine&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;0,900;1,400;1,700&family=Pacifico&display=swap',
            [],
            null
        );
    }

    public function setup_header_footer_hooks() {
        // Remove default Astra header & builder
        remove_action('astra_header', 'astra_header_markup');
        if (class_exists('Astra_Builder_Header')) {
            remove_action('astra_header', [Astra_Builder_Header::get_instance(), 'global_astra_header'], 0);
        }
        
        // Remove default Astra footer & builder
        remove_action('astra_footer', 'astra_footer_markup');
        if (class_exists('Astra_Builder_Footer')) {
            remove_action('astra_footer', [Astra_Builder_Footer::get_instance(), 'footer_markup'], 10);
        }

        // Add our custom Biblio header & footer
        add_action('astra_header', [$this, 'render_header'], 10);
        add_action('astra_footer', [$this, 'render_footer'], 10);
    }

    public function cart_fragment($fragments) {
        $count = (function_exists('WC') && WC()->cart) ? WC()->cart->get_cart_contents_count() : 0;
        $fragments['span.bb-cart-count-badge'] = '<span class="bb-cart-count-badge">(' . esc_html($count) . ')</span>';
        return $fragments;
    }

    // =====================================================================
    // SINGLE PRODUCT: Rename tabs
    // =====================================================================
    public function rename_product_tabs($tabs) {
        if (isset($tabs['description'])) {
            $tabs['description']['title'] = 'Giới Thiệu Sản Phẩm';
            $tabs['description']['priority'] = 10;
        }
        if (isset($tabs['reviews'])) {
            $tabs['reviews']['title'] = 'Nhận Xét Của Khách Hàng';
            $tabs['reviews']['priority'] = 30;
        }
        if (isset($tabs['additional_information'])) {
            unset($tabs['additional_information']); // we show our own detail table
        }
        return $tabs;
    }

    // =====================================================================
    // SINGLE PRODUCT: Book detail info table
    // =====================================================================
    public function product_meta_details() {
        global $product;
        if (!$product || !is_a($product, 'WC_Product')) return;

        $pid = $product->get_id();
        $author      = get_post_meta($pid, '_biblio_author', true);
        $translator  = get_post_meta($pid, '_biblio_translator', true);
        $publisher   = get_post_meta($pid, '_biblio_publisher', true);
        $distributor = get_post_meta($pid, '_biblio_distributor', true);
        $size        = get_post_meta($pid, '_biblio_size', true);
        $pages       = get_post_meta($pid, '_biblio_pages', true);
        $weight      = get_post_meta($pid, '_biblio_weight', true);
        $date        = get_post_meta($pid, '_biblio_date', true);
        $tags        = get_post_meta($pid, '_biblio_tags', true);

        // Only show if we have metadata
        if (!$author && !$publisher) return;
        ?>
        <!-- BIBLIO BOOK AUTHOR / PRICE META (above add-to-cart) -->
        <div class="biblio-book-author-line">
            <?php if ($author): ?>
            <span class="biblio-meta-author">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#209440" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <strong><?php echo esc_html($author); ?></strong> <em style="color:#888;">(Tác giả)</em>
            </span>
            <?php endif; ?>
            <?php if ($translator): ?>
            <span class="biblio-meta-translator">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#e87c00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <strong><?php echo esc_html($translator); ?></strong> <em style="color:#888;">(Dịch giả)</em>
            </span>
            <?php endif; ?>
        </div>

        <!-- THÔNG TIN CHI TIẾT TABLE -->
        <div class="biblio-detail-info-wrap">
            <h4 class="biblio-detail-info-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#209440" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                Thông Tin Chi Tiết
            </h4>
            <table class="biblio-detail-table">
                <?php if ($publisher): ?>
                <tr><th>Nhà xuất bản:</th><td><?php echo esc_html($publisher); ?></td></tr>
                <?php endif; ?>
                <?php if ($date): ?>
                <tr><th>Ngày xuất bản:</th><td><?php echo esc_html($date); ?></td></tr>
                <?php endif; ?>
                <?php if ($distributor): ?>
                <tr><th>Nhà phát hành:</th><td><?php echo esc_html($distributor); ?></td></tr>
                <?php endif; ?>
                <?php if ($size): ?>
                <tr><th>Kích thước:</th><td><?php echo esc_html($size); ?></td></tr>
                <?php endif; ?>
                <?php if ($pages): ?>
                <tr><th>Số trang:</th><td><?php echo esc_html($pages); ?> trang</td></tr>
                <?php endif; ?>
                <?php if ($weight): ?>
                <tr><th>Trọng lượng:</th><td><?php echo esc_html($weight); ?></td></tr>
                <?php endif; ?>
                <?php if ($tags): ?>
                <tr><th>Tags:</th><td><?php echo esc_html($tags); ?></td></tr>
                <?php endif; ?>
            </table>
        </div>
        <?php
    }

